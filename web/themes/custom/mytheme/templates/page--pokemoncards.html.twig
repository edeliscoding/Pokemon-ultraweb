{# /.layout-container #}

{{ page.meta_header }}

<header>
  {{ page.global_navigation }}
  {{ page.mobile_navigation }}
  {{ page.header }}
</header>

{{ page.help }}
{{ page.title_top }}
{{ page.page_top }}
{{ page.breadcrumb_top }}
{{ page.content_top }}

<div class="layout-with-sidebars">

  <main class="main-content">
    {{ page.highlighted }}
    {{ page.content }}
    {{ pokemon_content_block }}
  </main>

  {% if page.sidebar_first %}
    <aside class="sidebar-first">
      {{ page.sidebar_first }}
    </aside>
  {% endif %} 

  {% if page.sidebar_second %}
    <aside class="sidebar-second">
      {{ page.sidebar_second }}
       <!-- {{ pokemon_cards_block }} -->
      
    </aside>
  {% endif %}

</div>

{{ page.content_bottom }}
{{ page.page_bottom }}

<footer>
  {{ page.footer_top }}
  {{ page.footer_first }}
  {{ page.footer_middle }}
  {{ page.footer_last }}
  {{ page.footer_bottom }}
</footer> 