//CONTENT BLOCK WITH TWIG TEMPLATE page--pokemoncards.html.twig
// the key here is copying page.html.twig and placing pokemon_cars_block variable in the correct layout
// notice $variables['pokemon_content_block']. In twig it will be {{ pokemon_content_block }}

function mytheme_preprocess_page(array &$variables) {
  if (\Drupal::routeMatch()->getRouteName() === 'view.pokemon_cards.page_1') {

    $block = \Drupal\block_content\Entity\BlockContent::load(1);

    if ($block) {
      $variables['pokemon_content_block'] =
        \Drupal::entityTypeManager()
          ->getViewBuilder('block_content')
          ->view($block);
    }
  }
}

// teach chanise that load 1 is the block id when loading an unplaced content block. 2nd point is view.pokemon_cards.page_1
// is the view machine name and the machine name of the page which is page_1 in View for /pokemoncards View.

